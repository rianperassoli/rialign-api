# Copy to .env for local (non-Docker) runs. dotenv-rails loads it in dev/test.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=rianganizze_development
DATABASE_NAME_TEST=rianganizze_test

# REQUIRED in production. Used to sign JWTs.
JWT_SECRET_KEY=change-me-in-production

# Comma-separated allowed origins, or * for all.
CORS_ORIGINS=*
