#!/bin/bash -e

# Migrations run on boot only when RUN_MIGRATIONS=true, so a deploy never
# touches the database schema unless that is asked for explicitly.
# (Render's free plan has no pre-deploy command, so the entrypoint does it.)
# db:migrate, never db:prepare: on an empty database prepare also runs
# db/seeds.rb, which creates a demo user with a known password.
if [ "${RUN_MIGRATIONS}" = "true" ]; then
  echo "RUN_MIGRATIONS=true: running db:migrate"
  bundle exec rails db:migrate
fi

exec "${@}"
